{
  "__required__": [
    "service.name",
    "service.version",
    "db.host",
    "db.port",
    "log.level"
  ],
  "service": {
    "name": "myapp",
    "version": "1.0.0",
    "port": 8080,
    "timeout_ms": 5000
  },
  "db": {
    "port": 5432,
    "pool_size": 10,
    "ssl": false
  },
  "log": {
    "level": "INFO",
    "format": "json"
  },
  "features": {
    "cache": true,
    "beta": false
  },
  "allow_ips": [
    "10.0.0.0/8"
  ]
}
